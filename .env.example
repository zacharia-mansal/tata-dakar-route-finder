# Server-side migration/test connection only. Never add this to client build configuration.
DATABASE_URL=

# Server-side Vercel API connection only. Never add this to client build configuration.
DATABASE_URL_PUBLIC_API=

# Private server-side Stadia routing/geocoding key. Never add this to client build configuration.
STADIA_ROUTING_API_KEY=

# dbmate reads these settings from .env when present.
DBMATE_MIGRATIONS_DIR=db/migrations
DBMATE_SCHEMA_FILE=db/schema.sql

# Provisional per-minute limits for the server API (shared rate-limit storage is still required in deployments).
RATE_LIMIT_RESOLVE_PLACES_PER_MINUTE=
RATE_LIMIT_SEARCH_ROUTES_PER_MINUTE=
MAX_WALKING_CALLS_PER_REQUEST=
ALLOW_MEMORY_RATE_LIMIT=
